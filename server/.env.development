# Default environment DEVELOPMENT — non-rahasia dan DIKOMIT ke repository.
# Timpa nilai pribadi/rahasia lewat `.env.development.local` (gitignored).

NODE_ENV=development
PORT=9000
LOG_LEVEL=debug
ENABLE_DOCS=true

CORS_ORIGIN=http://localhost:5173

# Postgres lokal via Docker Compose (docker compose up -d di root repo)
# Host port 5433 → menghindari bentrok dengan Postgres native di 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hris

# Secret dummy khusus development — production memakai nilai dari Vercel Dashboard
JWT_SECRET=dev_only_access_secret_change_me
REFRESH_SECRET=dev_only_refresh_secret_change_me
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
