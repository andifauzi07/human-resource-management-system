# Template environment variables — salin sebagai acuan konfigurasi.
# Default development non-rahasia ada di `.env.development` (dikomit).
# Rahasia pribadi HANYA di `.env.development.local` (tidak dikomit).

# --- Runtime ---
NODE_ENV='development'
# Opsional di lingkungan serverless (Vercel tidak menyediakan PORT); default 9000.
PORT='9000'
LOG_LEVEL='debug'
# Kontrol ketersediaan Swagger UI (/api/docs). Nilai: 'true' | 'false'.
ENABLE_DOCS='true'

# Origin frontend yang diizinkan (pisahkan dengan koma untuk lebih dari satu).
CORS_ORIGIN='http://localhost:5173'

# --- Database ---
# Development lokal: Docker Compose (lihat docker-compose.yml di root repo).
# Host port 5433 menghindari bentrok dengan Postgres native di 5432.
DATABASE_URL='postgresql://postgres:postgres@localhost:5433/hris'

# --- Auth ---
# Dummy khusus development — GUNAKAN nilai kuat dan berbeda di production.
JWT_SECRET='dev_only_access_secret_change_me'
REFRESH_SECRET='dev_only_refresh_secret_change_me'
JWT_ACCESS_TOKEN_EXPIRES_IN='15m'
JWT_REFRESH_TOKEN_EXPIRES_IN='7d'
BCRYPT_SALT_ROUNDS='10'
